<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>tidy</string>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Tidy</string>
  <key>CFBundleDisplayName</key><string>Tidy</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSSupportsSuddenTermination</key><false/>
  <!-- Sparkle auto-update (app-updates/CONTRACT.md). The user's choices live in Sparkle's own
       defaults; these are the starting values. -->
  <key>SUFeedURL</key><string>https://sdusteric.github.io/app-updates/tidy/appcast.xml</string>
  <key>SUPublicEDKey</key><string>PMaW+8sZRzOkfIwy1KBGk0CHTVoN49FE9o8gUlNGdZc=</string>
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUAutomaticallyUpdate</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Tidy measures the size of folders in Documents to find large files and old project build folders.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Tidy measures the size of files on your Desktop to find large files.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Tidy measures the size of files in Downloads to find large files and old installers.</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>When an app you uninstall needs your password, Tidy asks Finder to move it to the Trash. Finder asks for the password, not Tidy.</string>
  <!-- Quick actions Shelf may offer (tidy://checkup, tidy://check-for-updates). Shelf reads this
       key from the installed bundle and hides any action an older build lacks. -->
  <key>SDShelfActions</key>
  <array><string>checkup</string><string>check-for-updates</string></array>
  <!-- tidy://checkup and tidy://check-for-updates. Only the installed app (bundle id
       dev.sdusteric.tidy) keeps it: scripts/bundle.sh deletes this key from any other bundle
       id, so a screenshot bundle never takes the scheme. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>Tidy Quick Actions</string>
      <key>CFBundleURLSchemes</key><array><string>tidy</string></array>
      <key>CFBundleTypeRole</key><string>Viewer</string>
    </dict>
  </array>
</dict>
</plist>
