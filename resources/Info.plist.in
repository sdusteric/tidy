<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>tidy</string>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleName</key><string>Tidy</string>
  <key>CFBundleDisplayName</key><string>Tidy</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>CFBundleVersion</key><string>@BUILD@</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSSupportsAutomaticTermination</key><false/>
  <key>NSSupportsSuddenTermination</key><false/>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Tidy measures the size of folders in Documents to find large files and old project build folders.</string>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Tidy measures the size of files on your Desktop to find large files.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Tidy measures the size of files in Downloads to find large files and old installers.</string>
</dict>
</plist>
